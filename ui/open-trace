#!/usr/bin/env bash
# Usage: open-trace <trace.json>
# Opens agentloop-trace-viewer.html with the given JSON pre-loaded.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VIEWER="$SCRIPT_DIR/agentloop-trace-viewer.html"
OUT="/tmp/agentloop-trace-viewer.html"

if [[ $# -lt 1 ]]; then
  echo "Usage: open-trace <trace.json>" >&2
  exit 1
fi

JSON_FILE="$(realpath "$1")"

if [[ ! -f "$JSON_FILE" ]]; then
  echo "Error: file not found: $JSON_FILE" >&2
  exit 1
fi

# Inject JSON safely via Python (avoids sed & / \ escaping issues)
python3 - "$VIEWER" "$JSON_FILE" "$OUT" << 'EOF'
import sys, json, pathlib, os

viewer_path, json_path, out_path = sys.argv[1], sys.argv[2], sys.argv[3]

viewer = pathlib.Path(viewer_path).read_text(encoding='utf-8')
data   = json.loads(pathlib.Path(json_path).read_bytes())
name   = os.path.basename(json_path)

injection = (
    '<script>'
    f'window.__INITIAL_TRACE__ = {json.dumps(data, ensure_ascii=False)};'
    f'window.__INITIAL_TRACE_FILE__ = {json.dumps(name)};'
    '</script>'
)
patched = viewer.replace('</head>', injection + '</head>', 1)
pathlib.Path(out_path).write_text(patched, encoding='utf-8')
EOF

# Open the stable output file (no deletion = no race)
if command -v open &>/dev/null; then
  open "$OUT"
elif command -v xdg-open &>/dev/null; then
  xdg-open "$OUT"
else
  echo "Open manually: $OUT" >&2
fi
